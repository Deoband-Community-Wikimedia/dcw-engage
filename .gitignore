# ----------------------------------------------------------------------
# DCW Engage Portal - Secure .gitignore
# ----------------------------------------------------------------------

# Security: Never commit environment variables or configuration files
config.php
.env
.env.*
!.env.example

# Security: Ignore all log files (prevents leaking sensitive errors/PII)
*.log
logs/
error_log
php_errors.log

# Dependencies
vendor/
node_modules/

# User Uploads (Strictly ignore all uploads except security configuration)
uploads/*
!uploads/.gitkeep
!uploads/.htaccess

# IDE & Editor specific files
.idea/
.vscode/
*.swp
*.swo
.project
.buildpath
*.suo
*.user

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
