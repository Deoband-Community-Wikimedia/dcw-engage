# ----------------------------------------------------------------------
# DCW Engage Portal - Secure .gitignore
# ----------------------------------------------------------------------

# Security: Never commit environment variables or configuration files
config.php
.env
.env.*
!.env.example

# Security: Certificates database credentials (real file lives only on the server)
# The committed template is includes/certs_db.example.php
includes/certs_db.php

# Optional events settings (the real file stays local; the committed template is includes/events_db.example.php)
includes/events_db.php

# Security: Ignore all log files (prevents leaking sensitive errors/PII)
*.log
logs/
error_log
php_errors.log

# Security: Database dumps and backups can contain applicant/member PII
*.sql.gz
*.sql.zip
*.dump
*.bak
backups/

# Dependencies
vendor/
node_modules/

# User Uploads (Strictly ignore all uploads except security configuration)
uploads/*
!uploads/.gitkeep
!uploads/.htaccess

# IDE & Editor specific files
.idea/
.vscode/
*.swp
*.swo
.project
.buildpath
*.suo
*.user

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Participant lists (names) and downloaded card PDFs (names + live QR tokens)
*.csv
*.xlsx
Event-Cards-*.pdf
DCW-Membership-Card-*.pdf

# Plain SQL dumps can contain PII. The schema and migrations are the only .sql files that belong in git.
*.sql
!database.sql
!migrations/*.sql

# Membership card private data: titles per Member ID, and the Board's signature image
config/card_titles.php
config/board_signature.*

# Keys and certificates
*.pem
*.key
