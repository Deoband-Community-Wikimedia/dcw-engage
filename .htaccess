# 1. Disable Directory Browsing
Options -Indexes

# 2. Hide Server Signature
ServerSignature Off

# 3. Protect Configuration & Hidden Files
#    .ftp-deploy-sync-state.json is the deploy tool's list of every file on the server (sizes and
#    hashes). The tool reads it over FTP, so blocking it on the web doesn't affect deploys.
<FilesMatch "^(config\.php|certs_db\.php|events_db\.php|\.env|\.git|\.ftp-deploy-sync-state\.json|database\.sql|composer\.(json|lock))">
    Require all denied
</FilesMatch>

# 3b. Never serve our own application log files over HTTP
<FilesMatch "\.log$">
    Require all denied
</FilesMatch>

# 3c. Never serve SQL files (schema dumps, the certificates view, backups)
<FilesMatch "\.sql$">
    Require all denied
</FilesMatch>

# 4. HTTP Security Headers
<IfModule mod_headers.c>
    Header set X-Frame-Options "SAMEORIGIN"
    Header set X-Content-Type-Options "nosniff"
    Header set X-XSS-Protection "1; mode=block"
    Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>

RewriteEngine On

# 5. Internal code folders are for PHP to require(), never for browsers.
#    (PHP includes read from disk, so this does not affect the site.)
#    views/ is reached only through index.php's routes; opening a view file
#    directly would skip the router.
RewriteRule ^(includes|models|views|vendor|migrations|bin|cron|docs|\.github)(/|$) - [F,L]

# 5b. Uploaded files (ID proofs, CVs, receipts) are never served directly. /file sends them after
#     checking who is asking (views/file.php). This rule lives here, not in uploads/.htaccess,
#     because the deploy leaves uploads/ alone.
RewriteRule ^uploads(/|$) - [F,L]

# 6. Route everything through index.php (except real files/folders)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [QSA,L]
