# Prevent execution of PHP and other scripts in the uploads directory
<FilesMatch "\.(php|php3|php4|php5|php7|php8|phtml|pl|py|jsp|asp|htm|html|shtml|sh|cgi)$">
    Require all denied
</FilesMatch>

# Prevent directory listing
Options -Indexes

# Force download instead of inline execution (optional, but good for security)
<FilesMatch "\.(pdf|doc|docx|jpg|jpeg|png|gif)$">
    Header set Content-Disposition attachment
</FilesMatch>
